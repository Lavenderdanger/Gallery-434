---
import '../styles/gallery.css'

---

<head>
    <style>
        html {
            margin: 0px;
            padding: 0px;
            min-height: 100vh;
            background-image: url('../assets/pattern.png');
            width: 100%;
            background-repeat: repeat;
            background-position: left top;
            }

        div.desc {
            padding: 10px;
            text-align: center;
            max-height: 280px;
            overflow: auto;
            border: 10px outset #99cccc;
            background-color: rgb(36, 36, 125);
        }
        /* 1. New wrapper to put the three displays next to each other */
        .gallery-wrapper {
            display: flex;            /* Aligns items side-by-side */
            justify-content: center;  /* Centers the three displays on the screen */
            gap: 20px;                /* Adds spacing between each display */
            width: 100%;
        }



        div.gallery:hover {
            border: 5px solid #777;
        }

/* 3. Your modified image styling */
        div.gallery img {
            width: 100%;             /* Fills the width of the display card */
            height: 250px;           /* Forces a uniform height for the container box */
            object-fit: scale-down;     /* Fits the ENTIRE image inside without cropping */
            object-position: center;
            background-color: #4c1d95; /* The image centers itself over your background */
            display: block;          
        }

    </style>
</head>

